    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/description"/>
        <Literal xml:lang="es">Ontología sobre el campo de la movilidad autónoma y sostenible que contiene información sobre sobre medios de transporte, infraestructuras físicas, gestión de movilidad y sostenibilidad, tecnologías relacionadas con la movilidad autónoma y sostenible o los acciones y procesos involucrados en la movilidad.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/isPartOf"/>
        <Literal xml:lang="es">INREED/2024/2 (EcoDrive TermSpace. Terminología multilingüe para la movilidad autónoma sostenible)</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/title"/>
