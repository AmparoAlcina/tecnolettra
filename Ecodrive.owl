        <AnnotationProperty IRI="http://purl.org/dc/terms/description"/>
        <IRI>http://purl.org/dc/elements/1.1/subject</IRI>
        <Literal xml:lang="en">Typically, the subject will be represented using keywords, key phrases, or classification codes.  Recommended best practice is to use a controlled vocabulary.</Literal>
