        <Literal>Poste recarga lenta . 1 toma, monofásico 230 V CA, 3,6 kW, 16 A. (MV0068-ES)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="ontodic:context"/>
        <IRI>http://tecnolettra.uji.es/InfraestructurasFisicas#posteRecargaLenta</IRI>
        <Literal>Poste recarga lenta . 2 tomas, monofásico 230 V CA, 7,2 kW, 16 A cada toma. (MV0068-ES)</Literal>
    </AnnotationAssertion>
