    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/description"/>
        <Literal xml:lang="es">Conjunto de actores que participan directa e indirectamente en el sistema de movilidad, incluyendo usuarios, responsables de la gestión, organismos y entidades y grupos sociales afectados por su funcionamiento, fabricantes.</Literal>
    </Annotation>
