        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#date">2012-06-14</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/terms/publisher"/>
        <IRI>http://purl.org/dc/elements/1.1/</IRI>
        <IRI>http://purl.org/dc/aboutdcmi#DCMI</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/terms/title"/>
        <IRI>http://purl.org/dc/elements/1.1/</IRI>
        <Literal xml:lang="en">Dublin Core Metadata Element Set, Version 1.1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/terms/description"/>
        <IRI>http://purl.org/dc/elements/1.1/contributor</IRI>
        <Literal xml:lang="en">The guidelines for using names of persons or organizations as creators also apply to contributors.  Typically, the name of a Contributor should be used to indicate the entity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/terms/issued"/>
        <IRI>http://purl.org/dc/elements/1.1/contributor</IRI>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#date">1999-07-02</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>http://purl.org/dc/elements/1.1/contributor</IRI>
        <Literal xml:lang="en">An entity responsible for making contributions to the resource.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:isDefinedBy"/>
        <IRI>http://purl.org/dc/elements/1.1/contributor</IRI>
        <IRI>http://purl.org/dc/elements/1.1/</IRI>
    </AnnotationAssertion>
