        <Literal>Asociación Europea de Vías Verdes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="ontodic:context"/>
        <IRI>http://tecnolettra.uji.es/actoresDeLaMovilidad#AsociaciónProfesionaldeTécnicosenMovilidadUrbanaSostenible</IRI>
        <Literal>Inventario de Planes de Movilidad Urbana Sostenible (PMUS) en España a marzo de 2016, vol. 39 Asociación Profesional de Técnicos en Movilidad Urbana Sostenible. (MV0134-ES)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://tecnolettra.uji.es/actoresDeLaMovilidad#AsociaciónProfesionaldeTécnicosenMovilidadUrbanaSostenible</IRI>
