    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#4.AccionesYProcesosEnMovilidad</IRI>
        <Literal>Actividades, dinámicas y operaciones que ocurren dentro del sistema de movilidad, como desplazamientos, intercambios, transferencias o cargas, cargas eléctricas de vehículos y carga y descarga de mercancías</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#4.1.TransporteDeMercancias</IRI>
