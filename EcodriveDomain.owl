    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#3.ActoresDeLaMovilidad</IRI>
        <Literal>Conjunto de actores que participan directa e indirectamente en el sistema de movilidad, incluyendo usuarios, responsables de la gestión, organismos y entidades y grupos sociales afectados por su funcionamiento, fabricantes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
