    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#4.5.4.NoMovilidad</IRI>
        <Literal>No desplazarse ni emplear ningún medio de transporte</Literal>
    </AnnotationAssertion>
