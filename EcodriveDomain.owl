        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#5.ModalidadesDeMovilidad</IRI>
        <Literal>Diferentes maneras en las que se pueden realizar los desplazamientos. Términos genéricos para referirse a todas estas maneras, su combinación o para referirse a la movilidad en general</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#5.1.MovilidadActiva</IRI>
        <Literal>Referido al tipo de movilidad que realizan las personas y que requiere un esfuerzo físico propio</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#5.2.MovilidadPorCarretera</IRI>
        <Literal>Modo de movilidad que se realiza empleando medios de transporte que tienen que desplazarse por carretera</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#5.3.MovilidadAerea</IRI>
        <Literal>Modo de movilidad que se realiza por aire, y todo lo que ello implica</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#5.4.MovilidadFerroviaria</IRI>
        <Literal>Modo de movilidad que se realiza por ferrocarril, y todo lo que ello implica</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/description"/>
        <IRI>#5.5.MovilidadMaritima</IRI>
