    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/description"/>
        <Literal xml:lang="es">Actividades, dinámicas y operaciones que ocurren dentro del sistema de movilidad, como desplazamientos, intercambios, transferencias o cargas, cargas eléctricas de vehículos y carga y descarga de mercancías.</Literal>
    </Annotation>
