    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/creator"/>
        <Literal>Amparo Alcina</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/description"/>
        <Literal xml:lang="es">Sistemas tecnológicos que permiten la automatización, digitalización y mejora ambiental de la movilidad. Se incluyen tanto los diferentes tipos de sistemas, como sus características.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/terms/isPartOf"/>
        <Literal>INREED/2024/2 (EcoDrive TermSpace. Terminología multilingüe para la movilidad autónoma sostenible)</Literal>
    </Annotation>
    <Annotation>
