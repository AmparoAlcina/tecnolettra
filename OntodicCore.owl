        <Literal>Amparo Alcina (https://orcid.org/0000-0002-4931-564X)</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:description"/>
        <Literal xml:lang="en">Firstly, the ONTODIC model formalizes natural language by separating
expression and content. Secondly, it formalizes conceptualization as the different
levels of linguistic analysis, which may be morphological, grammatical or semantic, among others.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="terms:title"/>
        <Literal>Ontodic</Literal>
    </Annotation>
