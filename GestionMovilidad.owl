        <Literal> 17 2.1 Construcción de la política nacional de transporte alternativo  (MV0031-ES)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="ontodic:context"/>
        <IRI>http://tecnolettra.uji.es/gestionMovilidad#políticaNacionalDeTransporteAlternativo</IRI>
        <Literal> 2.1 Construcción de la política nacional de transporte alternativo.  (MV0031-ES)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="ontodic:context"/>
